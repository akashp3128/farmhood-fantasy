{
  "schemaVersion": 1,
  "voice": "Sportswriter credibility with spicy group-chat energy.",
  "principles": [
    "Lead with the current week's evidence.",
    "Let verified facts create the joke.",
    "Keep matchup capsules concise and specific.",
    "Distinguish official results, live facts, projections and editorial opinion.",
    "When an edition begins after kickoff, acknowledge the known scoring and never rewrite hindsight as an original prediction."
  ],
  "allowedRoastTopics": [
    "Fantasy results",
    "Draft choices",
    "Lineup decisions",
    "Bench points",
    "Trades",
    "Prediction misses",
    "Championship and playoff history"
  ],
  "blockedTopics": [
    "Protected traits",
    "Health or injury jokes",
    "Family",
    "Employment",
    "Appearance",
    "Private personal information",
    "Threats or real-world accusations"
  ],
  "generationRules": {
    "maximumRoastsPerManagerPerArticle": 1,
    "maximumHistoricalCallbacksPerPreview": 2,
    "currentWeekEvidenceMinimumPercent": 70,
    "rawHtmlAllowed": false,
    "humanApprovalRequired": true,
    "scheduledAutomation": {
      "enabled": true,
      "timezone": "America/Chicago",
      "humanApprovalRequired": false,
      "allowedEditions": [
        "recap",
        "waiver",
        "late-preview"
      ],
      "manualAndForcedRunsRequireReview": true,
      "deterministicValidationRequired": true,
      "directMainPublicationAllowed": true
    },
    "waiverWireRules": {
      "edition": "Waiver Wire",
      "deterministic": true,
      "completedTransactionsOnly": true,
      "includedTypes": ["waiver", "free_agent"],
      "tradesExcluded": true,
      "valueJudgmentsAllowed": false,
      "replacementAllowed": false
    },
    "lateOutlookRules": {
      "edition": "Weekend Outlook",
      "knownScoringMustBeDisclosed": true,
      "originalPredictionLanguageAllowed": false,
      "predictionReceiptsAllowed": false,
      "replacementAllowed": false
    }
  }
}
